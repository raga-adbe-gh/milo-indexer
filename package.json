{
  "name": "miloindexer",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "dependencies": {
    "@adobe/aio-lib-core-logging": "^2.0.0",
    "@adobe/aio-lib-files": "^3.0.0",
    "@azure/msal-node": "1.16.0",
    "maskdata": "^1.3.3",
    "node-fetch": "2.6.11",
    "object-hash": "^2.2.0",
    "openwhisk": "3.21.7",
    "process": "^0.11.10",
    "unist-util-find": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@adobe/aio-cli": "^10.3.4",
    "@openwhisk/wskdebug": "^1.4.0",
    "eslint": "^8.8.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.5.3",
    "eslint-plugin-jsdoc": "^39.3.3",
    "eslint-plugin-n": "^15.2.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "expect": "^26.6.2",
    "glob": "^8.0.3",
    "jest": "^29.7.0",
    "jest-chain": "^1.1.6",
    "jest-runner-groups": "^2.2.0",
    "msw": "^2.7.3",
    "parse-multipart-data": "^1.5.0",
    "simple-node-logger": "^21.8.12",
    "wildcard-match": "^5.1.4"
  },
  "scripts": {
    "test": "jest --passWithNoTests ./test",
    "test-open": "jest --detectOpenHandles ./test",
    "test-rollout": "jest --passWithNoTests ./test/doRollout.test.js",
    "coverage": "jest --coverage --passWithNoTests ./test"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./actions/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 85,
        "statements": 85
      }
    },
    "automock": false,
    "resetMocks": false,
    "runner": "groups",
    "setupFilesAfterEnv": [
      "./test/jest.setup.js"
    ],
    "transform": {},
    "verbose": true
  }
}
